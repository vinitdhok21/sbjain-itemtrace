# Server Configuration
PORT=5000
NODE_ENV=development

# Client URL (CORS binding)
CLIENT_URL=http://localhost:5173

# Admin / Project Owner Email
ADMIN_EMAIL=dhokvinit@gmail.com

# Email Sender Address
EMAIL_FROM="SBJain ItemTrace" <notifications@sbjain.ac.in>

# SMTP Server Configuration (Optional for production email delivery)
# If left unset, email alerts will be cleanly simulated in console
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Supabase Credentials (Server-side)
SUPABASE_URL=https://your-supabase-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
